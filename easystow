########################################################################################################################
# EasyStow - GNU Stow helpers

########################################################################################################################
#
# GNU Stow operates on packages - minimal working units that represent collections of files and directories to back up:
# https://www.gnu.org/software/stow/manual/stow.html#Terminology
#
########################################################################################################################
#
# EasyStow operates on categories and packages.
#
# What you have inside your root dotfiles directory are categories, with one special category - 'secrets' - which has
# its own sub-categories. The purpose of 'secrets' category is to back up anything that contains sensitive data like
# passwords, auth keys, etc.
#
# What's inside categories and sub-categories is treated as packages.
#
########################################################################################################################
#
# E.g. in your '$HOME/backup/dotfiles' you have category directory 'shells' where you plan to store packages
# that represent miscellaneous shell-related config files.
#
# Then you might have sub-directoriess 'shells/bash' and 'shells/zsh', each storing a set of config files
# for respective shell. Here 'bash' and 'zsh' are packages.
#
# Example of categories layout:
#    dotfiles
#    ├── configs
#    ├── shells
#    ├── tools
#    └── secrets
#        ├── encryption
#        └── remote
#
########################################################################################################################
#
# Several aliases and functions are at your disposal:
#    stow-ls-structure - for listing storage structure (tree-view)
#    stow-ls-packages  - for listing all stowed packages (tree-view)
#
#    stow-simulate - for running stow packaging in simulation mode (stow option -n)
#    stow-do       - for stowing packages
#    stow-force    - for stowing packages in forced mode (stow option --adopt)
#    stow-unstow   - for un-stowing packages (stow option -D)
#    stow-restow   - for re-stowing packages (stow option -R)
#
########################################################################################################################
#
# Customization
#
# You may define DOTFILES_ROOT_DIR environment variable to point EasyStow to your dotfiles.


__EASYSTOW_ROOT_DIR="${DOTFILES_ROOT_DIR:-$HOME/backup/dotfiles}"  # root storage directory
__EASYSTOW_TARGET_DIR=$HOME  # target directory
__EASYSTOW_SECRETS_NAME=secrets  # sub-directory name for packages with sensitive info (passwords, auth tokens, etc.)
__EASYSTOW_SECRETS_ROOT_DIR=$__EASYSTOW_ROOT_DIR/$__EASYSTOW_SECRETS_NAME  # root secrets directory


alias stow-ls-structure="env tree -dL 1 -I $__EASYSTOW_SECRETS_NAME $__EASYSTOW_ROOT_DIR --noreport &&
                         env tree -dL 1 $__EASYSTOW_SECRETS_ROOT_DIR --noreport"
alias stow-ls-packages="env tree -dL 2 -I $__EASYSTOW_SECRETS_NAME $__EASYSTOW_ROOT_DIR --noreport &&
                        env tree -dL 2 $__EASYSTOW_SECRETS_ROOT_DIR --noreport"


# General autocompletion function for using in specific functions.
# Usage examples for function 'foo' bound to use completions:
#      foo <TAB><TAB> -> would output "configs shells tools" or whatever categories you have in dotfiles root
#      foo sec<TAB><TAB> -> will output "secrets"
#      foo secrets <TAB><TAB> -> would output "encryption remote" or whatever categories you have in your secrets root
#      foo shells <TAB><TAB> -> should output packages in category 'shells'
#      foo secrets remote <TAB><TAB> -> should output packages in sub-category 'remote' of 'secrets' category 
function __stow_package_completion(){
    latest="${COMP_WORDS[$COMP_CWORD]}"

    root_categories=$(cd $__EASYSTOW_ROOT_DIR && env ls -d */ 2>/dev/null | sed 's:/$::' 2>/dev/null)
    root_categories_array=($root_categories)

    secret_categories=$(cd $__EASYSTOW_SECRETS_ROOT_DIR && env ls -d */ 2>/dev/null | sed 's:/$::' 2>/dev/null)
    secret_categories_array=($secret_categories)

    arg1="${COMP_WORDS[1]}"
    arg2="${COMP_WORDS[2]}"
    arg1_regex_exact="\<${arg1}\>"  # will test for exact value, not regex part
    arg2_regex_exact="\<${arg2}\>"  # will test for exact value, not regex part
    completions=""

    if [ $COMP_CWORD -eq 1 ]; then
        # no args specified yet - choose category or 'secrets'

        # autocomplete with categories in root dotfiles directory
        completions="$root_categories"
    elif [ $arg1 == $__EASYSTOW_SECRETS_NAME ] && [ $COMP_CWORD -eq 2 ]; then
        # first arg is 'secrets', no 2nd arg specified yet - choose sub-category under 'secrets'

        # autocomplete with sub-categories in 'secrets' category
        completions="$secret_categories"
    elif [ $arg1 == $__EASYSTOW_SECRETS_NAME ] && [[ ${secret_categories_array[@]} =~ $arg2_regex_exact ]]; then
        # first arg is 'secrets'
        # second arg is a secrets sub-category - choose package

        completions=$(env ls $__EASYSTOW_ROOT_DIR/$arg1/$arg2 $(__build_comp_exclusions ${COMP_WORDS[@]}) 2>/dev/null)
    elif [[ ${root_categories_array[@]} =~ $arg1_regex_exact ]]; then
        # first arg is a root category - choose package

        completions=$(env ls $__EASYSTOW_ROOT_DIR/$arg1 $(__build_comp_exclusions ${COMP_WORDS[@]}) 2>/dev/null)
    fi
    COMPREPLY=($(compgen -W "$completions" -- $latest))
    return 0
}

# Build exclusions for completions we already selected, echo result (as bash cannot return strings).
# This result will be evaluated by calling function.
function __build_comp_exclusions() {
    exclusions=""  # -I option for ls command excludes files enumerated after it from displaying
    for package in $@; do
        exclusions+=" -I $package"
    done
    echo $exclusions
}

# Build arguments for stow command from autocomplete args returned by caller function.
# Args that are category directories or 'secrets' become parts of storage path.
# Remainder args will be treaded as stow packages.
function __build_stow_args() {
    arg_num=1
    directories=($(cd $__EASYSTOW_ROOT_DIR && env ls -d */ 2>/dev/null | sed 's:/$::' 2>/dev/null)
                 $(cd $__EASYSTOW_SECRETS_ROOT_DIR && env ls -d */ 2>/dev/null | sed 's:/$::' 2>/dev/null)
                )
    path_to_packages=$__EASYSTOW_ROOT_DIR  # start building path to packages from root dir

    # build path to packages from args (when category selected, it appends to this path)
    for arg in $@; do
        arg_regex_exact="\<${arg}\>"  # will test for exact value, not regex part
        if [[ ${directories[@]} =~ $arg_regex_exact ]]; then
            path_to_packages+="/$arg"
            ((arg_num++))
        else
            break
        fi
    done

    # check whether any category selected
    roots=($__EASYSTOW_ROOT_DIR $__EASYSTOW_SECRETS_ROOT_DIR)
    if [[ ${roots[@]} =~ $path_to_packages ]]; then
        return 1  # no packages can be listed in stow root or 'secrets'
    fi

    stow_packages=""
    stow_options=""
    # remainder args - treat them either as stow options (when arg begins with '-') or as stow packages
    for arg in ${@:$arg_num}; do
        if [[ $arg == -* ]]; then
            stow_options+=" $arg"
        else
            stow_packages+=" $arg"
        fi
    done

    # some category selected
    if [ -z "$stow_packages" ]; then
        # no packages specified - treat it as 'all packages in category'
        stow_packages=$(env ls $path_to_packages 2>/dev/null)
        if [ -z "$stow_packages" ]; then
            return 1 # no packages were listed in selected category
        else
            if [ ${@:((arg_num-2)):1} == $__EASYSTOW_SECRETS_NAME ]; then
                echo 1>&2 "Processing *all* packages in '${@:((arg_num-1)):1}' category of '$__EASYSTOW_SECRETS_NAME' ..."
            else
                echo 1>&2 "Processing *all* packages in '${@:((arg_num-1)):1}' category ..."
            fi
        fi
    else
        if [ ${@:((arg_num-2)):1} == $__EASYSTOW_SECRETS_NAME ]; then
            echo 1>&2 "Processing packages in '${@:((arg_num-1)):1}' category of '$__EASYSTOW_SECRETS_NAME':$stow_packages"
        else
            echo 1>&2 "Processing packages in '${@:((arg_num-1)):1}' category:$stow_packages"
        fi
    fi

    stow_args="-v -d $path_to_packages -t $__EASYSTOW_TARGET_DIR $stow_packages $stow_options"
    echo $stow_args # result will be evaluated by calling function
}

# Make an actual execute of stow command and process passed arguments.
# If last arg starts with '-' then extract it; from remainder args build stow command arguments (path/packages).
function __stow_execute() {
    stow_exec_option=""

    last_arg="${@: -1}"
    if [[ $last_arg == -* ]]; then    # last arg starts with '-' (like '-n' in 'stow-simulate')
        stow_exec_option+=$last_arg   # treat this arg as an option to the 'stow' command
        stow_args="$(__build_stow_args ${@:1:$#-1})" # from remainder args build stow arguments (path/packages)
    else
        stow_args="$(__build_stow_args $@)" # last arg does not start with '-', build stow arguments from all args
    fi

    # check return value of previous action (execution of __build_stow_args)
    retval=$?
    if [ $retval -ne 0 ]; then
        # if return value is not 0, then no packages were specified - notify user
        echo "Please specify either category and at least one package or just category"
    else
        # run stow command passing possible options and built arguments
        stow $stow_exec_option $stow_args
    fi
}


# stow in simulation mode
function stow-simulate() { __stow_execute $@ -n ; }

# actual stow packaging
function stow-do() { __stow_execute $@ ; }

# stow packaging with --adopt flag (kind of force - use it with caution as it will modify already stored content)
function stow-force() { __stow_execute $@ --adopt ; }

# un-stow
function stow-unstow() { __stow_execute $@ -D ; }

# re-stow
function stow-restow() { __stow_execute $@ -R ; }


# enable autocompletion for custom stow functions
complete -F __stow_package_completion "stow-simulate"
complete -F __stow_package_completion "stow-do"
complete -F __stow_package_completion "stow-force"
complete -F __stow_package_completion "stow-unstow"
complete -F __stow_package_completion "stow-restow"


